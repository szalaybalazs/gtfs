"""
Indicates exactly one field must be supplied and this field must not be `null`.
"""
directive @oneOf on INPUT_OBJECT

scalar JSON

"""
A date string, such as 2007-12-03, compliant with the `full-date` format outlined in section 5.6 of the RFC 3339 profile of the ISO 8601 standard for representation of dates and times using the Gregorian calendar.
"""
scalar Date

"""
A time string at UTC, such as 10:15:30Z, compliant with the `full-time` format outlined in section 5.6 of the RFC 3339profile of the ISO 8601 standard for representation of dates and times using the Gregorian calendar.
"""
scalar Time

"""
A date-time string at UTC, such as 2007-12-03T10:15:30Z, compliant with the `date-time` format outlined in section 5.6 of the RFC 3339 profile of the ISO 8601 standard for representation of dates and times using the Gregorian calendar.
"""
scalar DateTime

scalar Coordinates

type PointGeometry {
  type: String!
  coordinates: Coordinates!
}

type PointProps {
  id: Int!
  lat: Float
  lon: Float
}

type PointObject {
  type: String!
  geometry: PointGeometry
  properties: PointProps
}

type LineStringGeometry {
  type: String!
  coordinates: [Coordinates]
}

type FeatureCollection {
  type: String!
  features: [PointObject]
}

enum RouteType {
  TRAM
  SUBWAY
  RAIL
  BUS
  FERRY
  CABLE_TRAM
  AERIAL_LIFT
  FUNICULAR
  TROLLEYBUS
  MONORAIL
}

enum LocationType {
  STOP
  STATION
  ENTRANCE_EXIT
  GENERIC_NODE
  BOARDING_AREA
}

enum WheelchairBoarding {
  UNKNOWN
  AVAILABLE
  UNAVAILABLE
}

enum BikesAllowed {
  UNKNOWN
  ALLOWED
  NOT_ALLOWED
}

type Agency {
  agencyId: ID!
  name: String
  url: String
  timezone: String
  lang: String
  phone: String
  fareUrl: String
  routes: [Route]
  stops: [Stop]
}

type TimetableEntry {
  arrival: DateTime!
  departure: DateTime!
  serviceId: ID!
  tripId: ID!
  wheelchairAccessible: WheelchairBoarding!
  bikesAllowed: BikesAllowed!
}

type Route {
  routeId: ID!
  agency: Agency
  shortName: String
  longName: String
  desc: String
  type: RouteType
  url: String
  color: String
  textColor: String
  trips: [Trip]
  stops: [Stop]!
  closestStop(lat: Float, lon: Float): Stop
  directions: [Direction!]
}

type Direction {
  directionId: Int!
  headsign: String!
  stops: [Stop!]!
}

type RoutePaginated {
  data: [Route!]!
  total: Int
  page: Int
  limit: Int
  pages: Int
}

type Stop {
  stopId: ID!
  code: String
  name: String
  desc: String
  lat: Float
  lon: Float
  zoneId: ID
  url: String
  locationType: LocationType
  parentStation: ID
  timezone: String
  wheelchairBoarding: Int
  routes: [Route]
  trips: [Trip]
}

type StopPaginated {
  data: [Stop!]!
  total: Int
  page: Int
  limit: Int
  pages: Int
}

type Trip {
  route: Route
  serviceId: ID!
  tripId: ID!
  headsign: String
  directionId: Int
  blockId: ID
  shapeId: ID
  agency: Agency
  stops: [Stop]
  stopTimes: [StopTime]
  path: LineStringGeometry
}

type StopTime {
  trip: Trip
  arrivalTime: String
  departureTime: String
  stop: Stop
  stopSequence: Int
  pickupType: Int
  dropOffType: Int
  shapeDistTraveled: Float
}

type VehiclePosition {
  id: ID!
  bearing: Float
  latitude: Float
  longitude: Float
  speed: Float
  currentStopSequence: Int
  trip: Trip
  tripStartDate: String
  tripStartTime: String
  congestationLevel: String
  occupancyStatus: String
  occupationPercentage: Float
  vehicleId: ID
  vehicleLabel: String
  vehicleLicensePlate: String
  vehicleWheelchairAccessible: Boolean
  timestamp: DateTime
  createdTimestamp: DateTime
  expirationTimestamp: DateTime
}

type Calendar {
  serviceId: ID!
  monday: Int
  tuesday: Int
  wednesday: Int
  thursday: Int
  friday: Int
  saturday: Int
  sunday: Int
  startDate: String
  endDate: String
}

input BboxInput {
  minLat: Float!
  minLon: Float!
  maxLat: Float!
  maxLon: Float!
}

type AgencyPaginated {
  data: [Agency!]!
  total: Int
  page: Int
  limit: Int
  pages: Int
}

input RangeInput {
  start: Date!
  end: Date!
}

type Query {
  agencies(limit: Int, page: Int): AgencyPaginated!
  agency(id: ID!): Agency
  routes(limit: Int, page: Int): RoutePaginated!
  route(id: ID!): Route
  stops(limit: Int, page: Int): StopPaginated!
  stopsByBbox(bbox: BboxInput!): [Stop]!
  stopsByRadius(lat: Float!, lon: Float!, radius: Float!): [Stop]!
  stop(id: ID!): Stop
  vehiclePositions: [VehiclePosition]!
  shapes: FeatureCollection!
  timetable(stopId: ID!, routeId: ID!, range: RangeInput): [TimetableEntry!]!
}
